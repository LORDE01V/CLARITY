# CLARITY backend — copy to `.env` (never commit `.env`)
#
# Required for the real auth / org / invite path used by the frontend
# when VITE_AUTH_BYPASS=false. See docs/go-live-locally.md.
#
# From https://supabase.com → Project Settings → API:
#   SUPABASE_URL              = Project URL
#   SUPABASE_ANON_KEY         = anon public
#   SUPABASE_SERVICE_ROLE_KEY = service_role secret (backend only)
#   SUPABASE_JWT_SECRET       = JWT Settings → JWT Secret
#
# Then run migrations 001 → 003 in the Supabase SQL Editor.

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=PASTE_ANON_PUBLIC_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_SECRET_HERE
SUPABASE_JWT_SECRET=PASTE_JWT_SECRET_HERE

# Application
APP_ENV=development
APP_NAME=CLARITY
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Invite tokens
INVITE_TOKEN_EXPIRE_HOURS=72

# GitHub App (from the GitHub App settings page)
# Prefer a PEM file path (gitignored). Optionally set GITHUB_PRIVATE_KEY
# to the full PEM with \n newlines instead of a path.
# Local webhooks: npx smee -u <smee-url> -t http://127.0.0.1:8000/api/v1/github/webhooks
# See docs/github-app.md
GITHUB_APP_ID=
# Public slug from the App page URL: https://github.com/apps/{slug}
GITHUB_APP_SLUG=claritylocal
GITHUB_CLIENT_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_PRIVATE_KEY=
# Optional solo fallback when no Connect installation is stored yet
GITHUB_INSTALLATION_ID=
# Frontend origin for post-install redirect from /api/v1/github/callback
FRONTEND_ORIGIN=http://localhost:5173
