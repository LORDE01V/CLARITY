# CLARITY frontend — copy to `.env` (never commit `.env`)
#
# === Go live (real Supabase auth) ===
# 1. Open https://supabase.com → your project → Project Settings → API
# 2. Paste:
#      VITE_SUPABASE_URL      = Project URL
#      VITE_SUPABASE_ANON_KEY = anon public key
# 3. Keep VITE_API_BASE_URL pointing at your FastAPI
# 4. Keep VITE_AUTH_BYPASS=false (required for real login — never leave true in prod)

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=PASTE_ANON_PUBLIC_KEY_HERE
VITE_API_BASE_URL=http://127.0.0.1:8001/api/v1
VITE_AUTH_BYPASS=false

# Production (Cloudflare Pages): set the same keys in the host dashboard.
# VITE_API_BASE_URL=https://YOUR_SERVICE.onrender.com/api/v1
# See frontend/.env.production.example
