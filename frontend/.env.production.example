# Production build env (set these in Cloudflare Pages / Vercel — do not commit secrets)
#
# VITE_* vars are baked in at BUILD time. Redeploy after changing them.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=PASTE_ANON_PUBLIC_KEY_HERE
# Your Render API, including /api/v1
VITE_API_BASE_URL=https://YOUR_SERVICE.onrender.com/api/v1
VITE_AUTH_BYPASS=false
